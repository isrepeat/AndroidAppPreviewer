{
  "schemaVersion": 2,
  "name": "AndroidAppPreviewerPluginSdk",
  "versionSource": "../../Version.json",
  "projects": {
    "native": {
      "adapter": "component-sources",
      "component": "Projects/AndroidAppPreviewerPluginSdk/Files.json",
      "sourceRoot": "Projects/AndroidAppPreviewerPluginSdk",
      "publicHeaders": [
        "*.h",
        "Session/*.h"
      ],
      "includeRoot": "Projects",
      "headerDestination": "include",
      "sourceDestination": "src",
      "manifestDestination": "cmake/AndroidAppPreviewerPluginSdk.json"
    },
    "managed": {
      "adapter": "dotnet",
      "project": "Projects/AndroidAppPreviewerPluginSdk.Managed/UniversalDevKit.AndroidAppPreviewerPluginSdk.Managed.Net8.csproj",
      "operation": "build",
      "configuration": "Release"
    }
  },
  "contents": [
    {
      "project": "native",
      "root": "output",
      "destination": "."
    },
    {
      "project": "managed",
      "root": "output",
      "path": "AndroidAppPreviewer.PluginSDK.dll",
      "destination": "lib/net8.0"
    },
    {
      "source": "Packages/Windows/AndroidAppPreviewerPluginSdk/Delivery/CMake",
      "include": [
        "AndroidAppPreviewerPluginConfig.cmake",
        "UdkNuGetDependencies.cmake"
      ],
      "destination": "cmake"
    },
    {
      "source": "Packages/Windows/AndroidAppPreviewerPluginSdk/Delivery/NuGet",
      "include": [
        "Delivery.json"
      ],
      "destination": "cmake",
      "rename": {
        "Delivery.json": "UdkDependencies.json"
      }
    },
    {
      "source": ".",
      "include": [
        "LICENSE",
        "Packages/Windows/AndroidAppPreviewerPluginSdk/README.md"
      ],
      "destination": ".",
      "preserveHierarchy": false,
      "rename": {
        "LICENSE": "LICENSE.txt"
      }
    }
  ],
  "deliveries": {
    "NuGet": "Delivery/NuGet/Delivery.json"
  }
}