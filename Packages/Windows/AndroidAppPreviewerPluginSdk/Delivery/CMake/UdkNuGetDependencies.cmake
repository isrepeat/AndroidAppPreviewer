include_guard(GLOBAL)

function(android_app_previewer_import_udk manifest packages_root)
    if(NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "PluginSDK requires the Windows MSVC x64 UDK packages.")
    endif()
    find_program(ANDROID_APP_PREVIEWER_POWERSHELL NAMES pwsh powershell REQUIRED)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ReadUdkDependencies.ps1")
    execute_process(
        COMMAND "${ANDROID_APP_PREVIEWER_POWERSHELL}" -NoProfile -ExecutionPolicy Bypass
            -File "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ReadUdkDependencies.ps1" -Path "${manifest}"
        OUTPUT_VARIABLE delivery
        ERROR_VARIABLE error
        RESULT_VARIABLE result
        ENCODING UTF-8
    )
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Cannot read PluginSDK dependencies: ${error}")
    endif()
    string(JSON count LENGTH "${delivery}" dependencies)
    math(EXPR last "${count} - 1")
    set(version "")
    foreach(index RANGE ${last})
        string(JSON id GET "${delivery}" dependencies ${index} id)
        string(JSON dependency_version GET "${delivery}" dependencies ${index} version)
        if(version AND NOT version STREQUAL dependency_version)
            message(FATAL_ERROR "PluginSDK requires UDK packages from the same release.")
        endif()
        set(version "${dependency_version}")
        if(NOT IS_DIRECTORY "${packages_root}/${id}.${version}")
            message(FATAL_ERROR "Restore ${id} ${version} beside PluginSDK or set ANDROID_APP_PREVIEWER_UDK_PACKAGES_ROOT.")
        endif()
    endforeach()
    get_filename_component(packages_root "${packages_root}" ABSOLUTE)
    set(identity "${packages_root}|${version}")
    get_property(previous GLOBAL PROPERTY androidAppPreviewerUdkIdentity)
    if(previous)
        if(NOT previous STREQUAL identity)
            message(FATAL_ERROR "PluginSDK UDK package roots or versions conflict.")
        endif()
        return()
    endif()
    foreach(component Helpers XamlRuntime OpenGLESRenderer Diagnostic)
        set(root "${packages_root}/UniversalDevKit.${component}.${version}")
        if(NOT EXISTS "${root}/include/UniversalDevKit/Export.h")
            message(FATAL_ERROR "UDK package headers are missing: ${root}")
        endif()
        set(package_${component} "${root}")
    endforeach()

    # Package metadata specifies library names. ABI.h checks the CRT and compiler.
    add_library(AndroidAppPreviewerPlugin::UdkHeaders INTERFACE IMPORTED GLOBAL)
    set_property(TARGET AndroidAppPreviewerPlugin::UdkHeaders PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${package_Helpers}/include")
    foreach(component XamlRuntime OpenGLESRenderer Diagnostic)
        if(component STREQUAL "Diagnostic")
            set(variant Dynamic)
            set(kind SHARED)
        else()
            set(variant Static)
            set(kind STATIC)
        endif()
        set(target "UniversalDevKit::${component}.${variant}")
        if(TARGET "${target}")
            message(FATAL_ERROR "UDK target already exists outside the PluginSDK package context: ${target}")
        endif()
        add_library("${target}" ${kind} IMPORTED GLOBAL)
        set_target_properties("${target}" PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${package_${component}}/include"
            INTERFACE_COMPILE_FEATURES cxx_std_20
            INTERFACE_LINK_LIBRARIES AndroidAppPreviewerPlugin::UdkHeaders
            IMPORTED_CONFIGURATIONS "Debug;Release")
        foreach(configuration Debug Release)
            set(binary_root "${package_${component}}/binaries/Dynamic/${configuration}")
            file(READ "${binary_root}/Release.json" release)
            foreach(field version runtime architecture)
                string(JSON actual_${field} GET "${release}" ${field})
            endforeach()
            if(NOT actual_version STREQUAL version OR NOT actual_runtime STREQUAL "Dynamic" OR NOT actual_architecture STREQUAL "x64")
                message(FATAL_ERROR "Incompatible UDK package metadata: ${binary_root}")
            endif()
            string(JSON entries LENGTH "${release}" components)
            math(EXPR entry_last "${entries} - 1")
            unset(library)
            foreach(entry RANGE ${entry_last})
                string(JSON name GET "${release}" components ${entry} name)
                string(JSON mode GET "${release}" components ${entry} variant)
                if(name STREQUAL component AND mode STREQUAL variant)
                    string(JSON link_file GET "${release}" components ${entry} linkFile)
                    get_filename_component(library "${link_file}" NAME)
                    break()
                endif()
            endforeach()
            if(NOT library OR NOT EXISTS "${binary_root}/${library}" OR NOT EXISTS "${binary_root}/Abi.h")
                message(FATAL_ERROR "UDK package is missing ${component}.${variant}: ${binary_root}")
            endif()
            string(TOUPPER "${configuration}" config)
            if(kind STREQUAL "SHARED")
                get_filename_component(stem "${library}" NAME_WE)
                set(dll "${binary_root}/${stem}.dll")
                if(NOT EXISTS "${dll}")
                    message(FATAL_ERROR "UDK runtime DLL is missing: ${dll}")
                endif()
                set_target_properties("${target}" PROPERTIES "IMPORTED_IMPLIB_${config}" "${binary_root}/${library}" "IMPORTED_LOCATION_${config}" "${dll}")
                list(APPEND runtime_files "$<$<CONFIG:${configuration}>:${dll}>")
            else()
                set_property(TARGET "${target}" PROPERTY "IMPORTED_LOCATION_${config}" "${binary_root}/${library}")
            endif()
            set_property(TARGET "${target}" APPEND PROPERTY INTERFACE_COMPILE_OPTIONS "$<$<CONFIG:${configuration}>:/FI${binary_root}/Abi.h>")
        endforeach()
    endforeach()
    set_property(TARGET UniversalDevKit::Diagnostic.Dynamic APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS UNIVERSALDEVKIT_DIAGNOSTIC_DYNAMIC)
    set_property(TARGET UniversalDevKit::XamlRuntime.Static APPEND PROPERTY INTERFACE_LINK_LIBRARIES UniversalDevKit::Diagnostic.Dynamic)
    set_property(TARGET UniversalDevKit::OpenGLESRenderer.Static APPEND PROPERTY INTERFACE_LINK_LIBRARIES "UniversalDevKit::XamlRuntime.Static;UniversalDevKit::Diagnostic.Dynamic;UniversalDevKit::ANGLE")

    # The OpenGLESRenderer package includes ANGLE and its public headers.
    add_library(UniversalDevKit::ANGLE INTERFACE IMPORTED GLOBAL)
    set_property(TARGET UniversalDevKit::ANGLE PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${package_OpenGLESRenderer}/include/ANGLE")
    foreach(configuration Debug Release)
        set(angle "${package_OpenGLESRenderer}/assets/ANGLE/${configuration}")
        foreach(name libEGL libGLESv2)
            if(NOT EXISTS "${angle}/${name}.lib" OR NOT EXISTS "${angle}/${name}.dll")
                message(FATAL_ERROR "ANGLE library or DLL is missing: ${angle}/${name}")
            endif()
            set_property(TARGET UniversalDevKit::ANGLE APPEND PROPERTY INTERFACE_LINK_LIBRARIES "$<$<CONFIG:${configuration}>:${angle}/${name}.lib>")
        endforeach()
        file(GLOB dlls "${angle}/*.dll")
        foreach(dll IN LISTS dlls)
            list(APPEND runtime_files "$<$<CONFIG:${configuration}>:${dll}>")
        endforeach()
    endforeach()
    set_property(GLOBAL PROPERTY androidAppPreviewerUdkIdentity "${identity}")
    set_property(GLOBAL PROPERTY androidAppPreviewerUdkRuntimeFiles "${runtime_files}")
endfunction()

function(android_app_previewer_copy_udk_runtime target)
    get_property(files GLOBAL PROPERTY androidAppPreviewerUdkRuntimeFiles)
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different ${files} "$<TARGET_FILE_DIR:${target}>"
        COMMAND_EXPAND_LISTS VERBATIM)
endfunction()