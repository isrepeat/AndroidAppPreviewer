<Project>
  <PropertyGroup>
    <AndroidAppPreviewerArtifactProjectName>PackageRelease</AndroidAppPreviewerArtifactProjectName>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <RestorePackagesPath>../!tools/packages</RestorePackagesPath>
    <UdkPackageRepository>$(MSBuildProjectDirectory)/..</UdkPackageRepository>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UniversalDevKit.PackageTools" Version="0.5.0" PrivateAssets="all" />
    <UdkPackage Include="Packages/Windows/AndroidAppPreviewer/Package.json" Condition="'$(PreviewerPackage)' == '' or '$(PreviewerPackage)' == 'AndroidAppPreviewer'" />
    <UdkPackage Include="Packages/Windows/AndroidAppPreviewerPluginSdk/Package.json" Condition="'$(PreviewerPackage)' == '' or '$(PreviewerPackage)' == 'AndroidAppPreviewerPluginSdk'" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>