<Window Width="1500"
        Height="950" x:Class="AndroidAppPreviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:AndroidAppPreviewer"
        xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
        Title="Android App Previewer"
        MinWidth="1000"
        MinHeight="650"
        Background="#181818">
    <!--
        Декларативная оболочка превьювера: общие тёмные стили, панели редакторов,
        управление масштабом и устройством, а также область визуального превью.
        Состояние, загрузка файлов и обработчики событий находятся в MainWindow.xaml.cs.
    -->
    <Window.Resources>
        <!-- Общие ресурсы темы используются и стандартными WPF-контролами, и AvalonEdit. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                         Color="#242424" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}"
                         Color="#303030" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}"
                         Color="#3A3A3A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}"
                         Color="#535353" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}"
                         Color="#747474" />
        <SolidColorBrush x:Key="ControlBackgroundBrush"
                         Color="#252525" />
        <SolidColorBrush x:Key="ControlBorderBrush"
                         Color="#4A4A4A" />
        <SolidColorBrush x:Key="ControlForegroundBrush"
                         Color="#E6E6E6" />
        <Style TargetType="TextBox">
            <Setter Property="Padding"
                    Value="6 3" />
            <Setter Property="Background"
                    Value="#202020" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="CaretBrush"
                    Value="#F0D78C" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background"
                    Value="#252525" />
            <Setter Property="BorderBrush"
                    Value="#4A4A4A" />
            <Setter Property="Foreground"
                    Value="#E6E6E6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Padding="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchPanelButtonStyle"
               TargetType="Button">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="#303030" />
            <Setter Property="BorderBrush"
                    Value="#555555" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#454545" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5A4D26" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#D5BD7D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchPanelToggleButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="Padding"
                    Value="9 3" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Background"
                    Value="#303030" />
            <Setter Property="BorderBrush"
                    Value="#555555" />
            <Setter Property="Foreground"
                    Value="#E6E6E6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5A4D26" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#D5BD7D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="search:SearchPanel">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="search:SearchPanel">
                        <Border VerticalAlignment="Top"
                                HorizontalAlignment="Right" Background="#252525"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                Cursor="Arrow">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PART_searchTextBox"
                                         Width="525"
                                         Height="36"
                                         Margin="0 0 6 0"
                                         VerticalContentAlignment="Center"
                                         FontSize="16">
                                    <TextBox.Text>
                                        <Binding Path="SearchPattern"
                                                 RelativeSource="{RelativeSource TemplatedParent}"
                                                 UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <ExceptionValidationRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <Button Width="36"
                                        Height="36"
                                        Margin="0 0 6 0"
                                        Style="{StaticResource SearchPanelButtonStyle}"
                                        Command="search:SearchCommands.FindNext"
                                        ToolTip="Следующее совпадение (F3)">
                                    <local:SvgIconControl Width="18"
                                                          Height="18"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center" Source="Resources/Icons/find-next.svg"
                                                          Stroke="#E6E6E6"
                                                          StrokeThickness="2.25"/>
                                </Button>
                                <Button Width="36"
                                        Height="36"
                                        Margin="0 0 6 0"
                                        Style="{StaticResource SearchPanelButtonStyle}"
                                        Command="search:SearchCommands.FindPrevious"
                                        ToolTip="Предыдущее совпадение (Shift+F3)">
                                    <local:SvgIconControl Width="18"
                                                          Height="18"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center" Source="Resources/Icons/find-previous.svg"
                                                          Stroke="#E6E6E6"
                                                          StrokeThickness="2.25"/>
                                </Button>
                                <Button Width="36"
                                        Height="36"
                                        Margin="0"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SearchPanelButtonStyle}"
                                        Command="search:SearchCommands.CloseSearchPanel"
                                        Focusable="False">
                                    <local:SvgIconControl Width="18"
                                                          Height="18"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center" Source="Resources/Icons/close.svg"
                                                          Stroke="#E6E6E6"
                                                          StrokeThickness="2.25"/>
                                </Button>
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Margin="0 6 0 0"
                                            Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource SearchPanelToggleButtonStyle}"
                                                  ToolTip="Учитывать регистр"
                                                  Content="Aa"
                                                  IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ToggleButton Margin="4 0 0 0"
                                                  Style="{StaticResource SearchPanelToggleButtonStyle}"
                                                  ToolTip="Только целые слова"
                                                  Content="ab"
                                                  IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ToggleButton Margin="4 0 0 0"
                                                  Style="{StaticResource SearchPanelToggleButtonStyle}"
                                                  ToolTip="Регулярное выражение"
                                                  Content=".*"
                                                  IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding"
                    Value="12 5" />
            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#383838" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#707070" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#4A4A4A" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#9D8D4D" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorModeToggleButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="Padding"
                    Value="12 5" />
            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#383838" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#707070" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5A4D26" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#9D8D4D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WireframeCheckBoxStyle"
               TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="#E6E6E6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="14"
                                    Height="14"
                                    Margin="0 0 6 0"
                                    VerticalAlignment="Center"
                                    Background="#151515"
                                    BorderBrush="#6B6B6B"
                                    BorderThickness="1">
                                <TextBlock x:Name="Checkmark"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#D5BD7D"
                                           Text="✓"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="#A89756" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Box"
                                        Property="Background"
                                        Value="#342F1C" />
                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="#D5BD7D" />
                                <Setter TargetName="Checkmark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorSwitchToggleButtonStyle"
               TargetType="ToggleButton">
            <Setter Property="Padding"
                    Value="12 5" />
            <Setter Property="Background"
                    Value="#181818" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#303030" />
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#707070" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding"
                    Value="6 3" />
            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ToggleButton x:Name="DropDownToggleButton"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ToggleBorder"
                                                        Background="{TemplateBinding Background}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="ToggleBorder"
                                                                Property="Background"
                                                                Value="#303030" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked"
                                                             Value="True">
                                                        <Setter TargetName="ToggleBorder"
                                                                Property="Background"
                                                                Value="#333333" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False"/>
                                    <Path Width="10"
                                          Height="6"
                                          Margin="0 0 8 0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Data="M 0 0 L 10 0 L 5 6 Z"
                                          Fill="#B8B8B8"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Border}"
                                   PopupAnimation="Slide">
                                <Border Margin="0 2 0 0" MinWidth="{Binding ActualWidth, ElementName=Border}"
                                        Background="#252525"
                                        BorderBrush="{StaticResource ControlBorderBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer MaxHeight="300"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"
                    Value="8 5" />
            <Setter Property="Background"
                    Value="#252525" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#5A4D26" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type avalonedit:TextEditor}">
            <Setter Property="Background"
                    Value="#1E1E1E" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
            <Setter Property="LineNumbersForeground"
                    Value="#858585" />
        </Style>
        <Style x:Key="ScrollBarButton"
               TargetType="RepeatButton">
            <Setter Property="Background"
                    Value="#2B2B2B" />
            <Setter Property="BorderBrush"
                    Value="#4A4A4A" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3A3A3A" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#747474" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#5A4D26" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D5BD7D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumbVertical"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="1 0"
                                Background="#5E5E5E"
                                BorderBrush="#777777"
                                BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#8A8A8A" />
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#D5BD7D" />
                                <Setter TargetName="ThumbBorder"
                                        Property="BorderBrush"
                                        Value="#F0D78C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumbHorizontal"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="0 1"
                                Background="#5E5E5E"
                                BorderBrush="#777777"
                                BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#8A8A8A" />
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#D5BD7D" />
                                <Setter TargetName="ThumbBorder"
                                        Property="BorderBrush"
                                        Value="#F0D78C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarPageButton"
               TargetType="RepeatButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="IsTabStop"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalScrollBarTemplate"
                         TargetType="ScrollBar">
            <Grid SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}" />
                    <RowDefinition Height="0.00001*" />
                    <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}" />
                </Grid.RowDefinitions>
                <Border Grid.Row="1"
                        Background="#242424"
                        BorderBrush="#4A4A4A"
                        BorderThickness="1 0" />
                <RepeatButton Grid.Row="0"
                              Command="{x:Static ScrollBar.LineUpCommand}"
                              Style="{StaticResource ScrollBarButton}">
                    <Path Margin="3 4 3 3" Data="M 0,4 L 3.5,0.5 L 7,4 L 7,6 L 3.5,2.5 L 0,6 z"
                          Fill="#B8B8B8"
                          Stretch="Uniform"/>
                </RepeatButton>
                <Track x:Name="PART_Track"
                       Grid.Row="1"
                       IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbVertical}" />
                    </Track.Thumb>
                </Track>
                <RepeatButton Grid.Row="2"
                              Command="{x:Static ScrollBar.LineDownCommand}"
                              Style="{StaticResource ScrollBarButton}">
                    <Path Margin="3 3 3 4" Data="M 0,0.5 L 3.5,4 L 7,0.5 L 7,2.5 L 3.5,6 L 0,2.5 z"
                          Fill="#B8B8B8"
                          Stretch="Uniform"/>
                </RepeatButton>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                         TargetType="ScrollBar">
            <Grid SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}" />
                    <ColumnDefinition Width="0.00001*" />
                    <ColumnDefinition MaxWidth="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1"
                        Background="#242424"
                        BorderBrush="#4A4A4A"
                        BorderThickness="0 1" />
                <RepeatButton Grid.Column="0"
                              Command="{x:Static ScrollBar.LineLeftCommand}"
                              Style="{StaticResource ScrollBarButton}">
                    <Path Margin="4 3 3 3" Data="M 4,0 L 0.5,3.5 L 4,7 L 6,7 L 2.5,3.5 L 6,0 z"
                          Fill="#B8B8B8"
                          Stretch="Uniform"/>
                </RepeatButton>
                <Track x:Name="PART_Track"
                       Grid.Column="1"
                       IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Style="{StaticResource ScrollBarPageButton}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbHorizontal}" />
                    </Track.Thumb>
                </Track>
                <RepeatButton Grid.Column="2"
                              Command="{x:Static ScrollBar.LineRightCommand}"
                              Style="{StaticResource ScrollBarButton}">
                    <Path Margin="3 3 4 3" Data="M 0,0 L 3.5,3.5 L 0,7 L 2,7 L 5.5,3.5 L 2,0 z"
                          Fill="#B8B8B8"
                          Stretch="Uniform"/>
                </RepeatButton>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background"
                    Value="#242424" />
            <Setter Property="BorderBrush"
                    Value="#4A4A4A" />
            <Setter Property="Foreground"
                    Value="#B8B8B8" />
            <Style.Triggers>
                <Trigger Property="Orientation"
                         Value="Vertical">
                    <Setter Property="Template"
                            Value="{StaticResource VerticalScrollBarTemplate}" />
                </Trigger>
                <Trigger Property="Orientation"
                         Value="Horizontal">
                    <Setter Property="Template"
                            Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource ControlForegroundBrush}" />
        </Style>
    </Window.Resources>
    <!-- Верхняя панель управляет режимом и текущими файлами; ниже располагаются редактор и превью. -->
    <Grid Background="#181818">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel
                   Margin="10">
            <ToggleButton x:Name="ScenarioButton"
                          Width="150"
                          Margin="0 0 8 0"
                          Style="{StaticResource EditorSwitchToggleButtonStyle}"
                          Click="ScenarioButtonClick"
                          Visibility="Visible">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="XamlModeText"
                               Text="XAML" />
                    <TextBlock Margin="8 0"
                               Foreground="#777777"
                               Text="/" />
                    <TextBlock x:Name="ScenarioModeText"
                               Text="Сценарии" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="SettingsButton"
                          Width="100"
                          Margin="0 0 8 0"
                          Style="{StaticResource EditorModeToggleButtonStyle}"
                          Click="SettingsButtonClick"
                          Content="Настройки"/>
            <Button x:Name="OpenButton"
                    Width="90"
                    Margin="0 0 8 0"
                    Click="OpenButtonClick"
                    Content="Открыть"
                    Visibility="Collapsed" />
            <Button x:Name="SelectPreviewPluginButton"
                    Width="145"
                    Margin="0 0 8 0"
                    Click="SelectPreviewPluginButtonClick"
                    Content="Выбрать приложение" />
            <Button x:Name="SaveButton"
                    Width="90"
                    Margin="0 0 16 0"
                    IsEnabled="False"
                    Click="SaveButtonClick"
                    Content="Сохранить" />
            <Button x:Name="ResetSessionButton"
                    Width="110"
                    Margin="0 0 8 0"
                    Click="ResetSessionButtonClick"
                    Content="Перезапустить" />
            <ToggleButton x:Name="NavigationGraphToggleButton"
                          Width="92"
                          Margin="0 0 8 0"
                          Style="{StaticResource EditorModeToggleButtonStyle}"
                          Click="NavigationGraphToggleButtonClick"
                          ToolTip="Показать маршрут приложения"
                          Content="Маршрут" />
            <Button Width="30"
                    Click="EditorZoomOutButtonClick"
                    Content="−" />
            <TextBlock x:Name="EditorZoomText"
                       Width="54"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <Button Width="30"
                    Margin="0 0 16 0"
                    Click="EditorZoomInButtonClick"
                    Content="+" />
            <TextBlock Margin="0 0 8 0"
                       VerticalAlignment="Center"
                       Foreground="#DDDDDD"
                       Text="Страница:"
                       Visibility="Collapsed" />
            <ComboBox x:Name="PagePicker"
                      Width="180"
                      Margin="0 0 16 0"
                      SelectionChanged="PagePickerSelectionChanged"
                      Visibility="Collapsed" />
            <TextBlock Margin="0 0 8 0"
                       VerticalAlignment="Center"
                       Foreground="#DDDDDD"
                       Text="Контролы:" />
            <ComboBox x:Name="ControlPicker"
                      Width="150"
                      Margin="0 0 16 0"
                      SelectionChanged="ControlPickerSelectionChanged" />
            <TextBlock x:Name="ScenarioLabel"
                       Margin="0 0 8 0"
                       VerticalAlignment="Center"
                       Foreground="#DDDDDD"
                       Text="Сценарий:"
                       Visibility="Collapsed" />
            <ComboBox x:Name="ScenarioPicker"
                      Width="160"
                      Margin="0 0 16 0"
                      SelectionChanged="ScenarioPickerSelectionChanged"
                      Visibility="Collapsed" />
            <Button x:Name="SaveScenarioToStorageButton" Content="Сохранить" Margin="-8 0 8 0" Click="SaveScenarioToStorageButtonClick" Visibility="Collapsed" />
            <TextBlock x:Name="FilePathText"
                       Margin="16 0 0 0"
                       VerticalAlignment="Center"
                       Foreground="#999999"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn"
                                  Width="1.15*" />
                <ColumnDefinition x:Name="EditorNavigationSplitterColumn"
                                  Width="Auto" />
                <ColumnDefinition x:Name="WorkspaceColumn"
                                  Width="1*" />
            </Grid.ColumnDefinitions>
            <avalonedit:TextEditor x:Name="MarkupEditor"
                                   Margin="10"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="14"
                                   HorizontalScrollBarVisibility="Auto"
                                   ShowLineNumbers="True"
                                   TextChanged="EditorTextChanged"
                                   PreviewKeyDown="EditorPreviewKeyDown"
                                   VerticalScrollBarVisibility="Auto" />
            <Border x:Name="NavigationGraphPanel"
                    Margin="10"
                    Background="#292929"
                    BorderBrush="#515151"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="10 8"
                               Foreground="#DDDDDD"
                               Text="Маршрут приложения" />
                    <local:NavigationGraphControl x:Name="NavigationGraphControl"
                                                  Grid.Row="1" />
                </Grid>
            </Border>
            <Button x:Name="ExpandAllFoldingsButton"
                    Width="100"
                    Height="28"
                    Margin="0 16 38 0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Background="#FF25282C"
                    BorderBrush="#FF4B535A"
                    Foreground="#FFF2F4F5"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Grid.ZIndex="1"
                    ToolTip="Раскрыть все свёрнутые теги"
                    Visibility="Collapsed"
                    Click="ExpandAllFoldingsButtonClick">
                <local:SvgIconControl Width="18"
                                      Height="18"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center" Source="Resources/Icons/expand-all.svg"
                                      Stroke="#FFF2F4F5"
                                      StrokeThickness="2.25"/>
            </Button>
            <Grid x:Name="FolderPickerPanel"
                  Margin="10"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#E6E6E6"
                           Text="Выберите папку с XAML" />
                <DockPanel Grid.Row="1"
                           Margin="0 10 0 10">
                    <Button x:Name="FolderPickerBackButton"
                            Width="40"
                            Height="36"
                            Margin="0 0 4 0"
                            Click="FolderPickerBackButtonClick"
                            DockPanel.Dock="Left">
                        <local:SvgIconControl Width="22"
                                              Height="22"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" Source="Resources/Icons/navigate-back.svg"
                                              Stroke="#E6E6E6"
                                              StrokeThickness="2.5"/>
                    </Button>
                    <Button x:Name="FolderPickerForwardButton"
                            Width="40"
                            Height="36"
                            Margin="0 0 4 0"
                            Click="FolderPickerForwardButtonClick"
                            DockPanel.Dock="Left">
                        <local:SvgIconControl Width="22"
                                              Height="22"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" Source="Resources/Icons/navigate-forward.svg"
                                              Stroke="#E6E6E6"
                                              StrokeThickness="2.5"/>
                    </Button>
                    <Button Width="40"
                            Height="36"
                            Margin="0 0 8 0"
                            Click="FolderPickerUpButtonClick"
                            DockPanel.Dock="Left">
                        <local:SvgIconControl Width="22"
                                              Height="22"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" Source="Resources/Icons/find-previous.svg"
                                              Stroke="#E6E6E6"
                                              StrokeThickness="2.5"/>
                    </Button>
                    <TextBox x:Name="FolderPickerPathText"
                             Background="#202020"
                             BorderBrush="#4A4A4A"
                             Foreground="#DDDDDD"
                             KeyDown="FolderPickerPathTextKeyDown" />
                </DockPanel>
                <TextBlock x:Name="FolderPickerErrorText"
                           Grid.Row="2"
                           Foreground="#FF8A80"
                           TextWrapping="Wrap" />
                <ListBox x:Name="FolderPickerEntries"
                         Grid.Row="3"
                         Background="#202020"
                         BorderBrush="#4A4A4A"
                         BorderThickness="1"
                         Foreground="#E6E6E6"
                         MouseDoubleClick="FolderPickerEntriesMouseDoubleClick"
                         PreviewKeyDown="FolderPickerEntriesPreviewKeyDown"
                         PreviewMouseLeftButtonDown="FolderPickerEntriesPreviewMouseLeftButtonDown"
                         SelectionChanged="FolderPickerEntriesSelectionChanged" />
                <StackPanel Grid.Row="4"
                            Margin="0 10 0 0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Width="90"
                            Margin="0 0 8 0"
                            Click="CancelFolderPickerButtonClick"
                            Content="Отмена" />
                    <Button x:Name="SelectFolderButton"
                            Width="90"
                            Click="SelectFolderButtonClick"
                            Content="Выбрать" />
                </StackPanel>
            </Grid>
            <local:HorizontalSplitter x:Name="EditorNavigationSplitter"
                                      Grid.Column="1"
                                      ThumbWidth="12"
                                      Background="#333333"
                                      DragCompleted="EditorSplitterDragCompleted" />
            <Grid Grid.Column="2">
                <Grid x:Name="PreviewPanel"
                      Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0 0 0 8"
                           VerticalAlignment="Center">
                    <Button Width="30"
                            Click="ZoomOutButtonClick"
                            Content="−" />
                    <TextBlock x:Name="ZoomText"
                               Width="54"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <Button Width="30"
                            Margin="0 0 8 0"
                            Click="ZoomInButtonClick"
                            Content="+" />
                    <Button Width="80"
                            Margin="0 0 16 0"
                            Click="FitPreviewButtonClick"
                            Content="Вписать" />
                    <TextBlock Margin="0 0 6 0"
                               VerticalAlignment="Center"
                               Text="Экран:" />
                    <ComboBox x:Name="DevicePresetPicker"
                              Width="175"
                              Margin="0 0 16 0"
                              SelectionChanged="DevicePresetPickerSelectionChanged" />
                    <TextBlock Margin="0 0 6 0"
                               VerticalAlignment="Center"
                               Text="Анимация:" />
                    <ComboBox x:Name="AnimationSpeedPicker"
                              Width="72"
                              Margin="0 0 16 0"
                              SelectionChanged="AnimationSpeedPickerSelectionChanged" />
                    <ToggleButton x:Name="PreviewOrientationToggle"
                                  Width="190"
                                  Margin="0 0 8 0"
                                  Style="{StaticResource EditorSwitchToggleButtonStyle}"
                                  Click="PreviewOrientationToggleClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PortraitOrientationText"
                                       Text="Портрет" />
                            <TextBlock Margin="8 0"
                                       Foreground="#777777"
                                       Text="/" />
                            <TextBlock x:Name="LandscapeOrientationText"
                                       Text="Альбомная" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ElementSelectionButton"
                                  Width="150"
                                  Margin="0 0 8 0"
                                  Style="{StaticResource EditorModeToggleButtonStyle}"
                                  Click="ElementSelectionButtonClick"
                                  Content="Выбор элемента" />
                    <CheckBox x:Name="ElementSelectionMarginCheckBox"
                              Margin="0 0 8 0"
                              Style="{StaticResource WireframeCheckBoxStyle}"
                              Click="ElementSelectionWireframeOptionClick"
                              Content="Margin" />
                    <CheckBox x:Name="ElementSelectionPaddingCheckBox"
                              Style="{StaticResource WireframeCheckBoxStyle}"
                              Click="ElementSelectionWireframeOptionClick"
                              Content="Padding" />
                </WrapPanel>
                <Border Grid.Row="1"
                        Background="#101010"
                        BorderBrush="#555555"
                        BorderThickness="1">
                    <ScrollViewer x:Name="PreviewViewport"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  HorizontalScrollBarVisibility="Auto"
                                  LostMouseCapture="PreviewViewportLostMouseCapture"
                                  PreviewMouseLeftButtonDown="PreviewViewportPreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="PreviewViewportPreviewMouseLeftButtonUp"
                                  PreviewMouseMove="PreviewViewportPreviewMouseMove"
                                  PreviewMouseWheel="PreviewViewportPreviewMouseWheel"
                                  ScrollChanged="PreviewViewportScrollChanged"
                                  VerticalScrollBarVisibility="Auto">
                        <Viewbox x:Name="PreviewViewbox"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Stretch="Uniform">
                            <Border x:Name="DeviceSurface"
                                    ClipToBounds="True" />
                        </Viewbox>
                    </ScrollViewer>
                </Border>
                </Grid>
            </Grid>
            <Grid x:Name="SettingsPanel"
                  Grid.Column="0"
                  Margin="10"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0 0 0 8"
                           Foreground="#DDDDDD"
                           Text="Настройки previewer (JSON)" />
                <avalonedit:TextEditor x:Name="SettingsEditor"
                                       Grid.Row="1"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="14"
                                       HorizontalScrollBarVisibility="Auto"
                                       ShowLineNumbers="True"
                                       TextChanged="EditorTextChanged"
                                       PreviewKeyDown="EditorPreviewKeyDown"
                                       VerticalScrollBarVisibility="Auto" />
            </Grid>
            <Grid x:Name="ScenarioPanel"
                  Grid.Column="0"
                  Margin="10"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0 0 0 8"
                           Foreground="#DDDDDD"
                           Text="Сценарии (JSON)" />
                <avalonedit:TextEditor x:Name="ScenarioEditor"
                                       Grid.Row="1"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="14"
                                       HorizontalScrollBarVisibility="Auto"
                                       ShowLineNumbers="True"
                                       TextChanged="EditorTextChanged"
                                       PreviewKeyDown="EditorPreviewKeyDown"
                                       VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Padding="10 6"
                   Background="#252525"
                   Foreground="#8FD18B"
                   Text="Готово" />
    </Grid>
</Window>