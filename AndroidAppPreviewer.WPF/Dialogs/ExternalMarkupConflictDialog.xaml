<Window x:Class="AndroidAppPreviewer.ExternalMarkupConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файл изменён извне"
        Width="560"
        Height="245"
        MinWidth="560"
        MinHeight="245"
        MaxWidth="560"
        MaxHeight="245"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#181818">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle"
               TargetType="Button">
            <Setter Property="MinWidth"
                    Value="108" />
            <Setter Property="Padding"
                    Value="14 7" />
            <Setter Property="Background"
                    Value="#2C2C2C" />
            <Setter Property="BorderBrush"
                    Value="#5A5A5A" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Foreground"
                    Value="#F0F0F0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#414141" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#E0B73E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverwriteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background"
                    Value="#792D32" />
            <Setter Property="BorderBrush"
                    Value="#D56A6E" />
            <Setter Property="Foreground"
                    Value="#FFF2F2" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#F0F0F0"
                   Text="Файл был изменён извне" />
        <StackPanel Grid.Row="1"
                    Margin="0 14 0 12">
            <TextBlock Foreground="#D0D0D0"
                       Text="Внешнее приложение изменило исходный XAML после его загрузки в previewer." />
            <TextBlock Margin="0 8 0 0"
                       Foreground="#D0D0D0"
                       Text="Перезаписать внешний вариант вашими несохранёнными изменениями?"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="MarkupPathText"
                       Margin="0 10 0 0"
                       Foreground="#9EB9D6"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    Margin="0 0 8 0"
                    Style="{StaticResource DialogButtonStyle}"
                    IsCancel="True"
                    IsDefault="True"
                    Content="Отмена" />
            <Button Style="{StaticResource OverwriteButtonStyle}"
                    Click="OverwriteButtonClick"
                    Content="Перезаписать" />
        </StackPanel>
    </Grid>
</Window>