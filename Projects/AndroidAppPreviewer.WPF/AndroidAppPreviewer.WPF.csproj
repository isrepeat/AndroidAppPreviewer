<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AndroidAppPreviewer</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AndroidAppPreviewerPluginSdk.Managed/AndroidAppPreviewerPluginSdk.Managed.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <ApplicationDefinition Include="App.xaml" />
    <Compile Include="**/*.cs" Exclude="obj/**;bin/**" />
    <Page Include="**/*.xaml" Exclude="App.xaml;obj/**;bin/**" />
    <Resource Include="Resources/Icons/*.svg" />
    <Content Include="Resources/Cursors/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources/Fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>