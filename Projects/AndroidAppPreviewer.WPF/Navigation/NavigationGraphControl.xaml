<UserControl x:Class="AndroidAppPreviewer.NavigationGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AndroidAppPreviewer">
    <UserControl.Resources>
        <ControlTemplate x:Key="NavigationNodeButtonTemplate"
                         TargetType="Button">
            <Border x:Name="NodeBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter TargetName="NodeBorder"
                            Property="BorderBrush"
                            Value="#EFBF41" />
                    <Setter TargetName="NodeBorder"
                            Property="BorderThickness"
                            Value="2" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <DataTemplate x:Key="NavigationPathCardTemplate">
            <Border Margin="0 0 0 8"
                    Padding="10"
                    Cursor="Hand"
                    ToolTip="Один клик выбирает этот путь; двойной клик подтверждает переход."
                    MouseLeftButtonDown="PathCardMouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="#303030" />
                        <Setter Property="BorderBrush"
                                Value="#5C5C5C" />
                        <Setter Property="BorderThickness"
                                Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="#4E411C" />
                                <Setter Property="BorderBrush"
                                        Value="Gold" />
                                <Setter Property="BorderThickness"
                                        Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0 5 0 0"
                                           Foreground="#DADADA"
                                           Text="{Binding}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="PathCandidatesScrollViewer"
                      Margin="8"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="PathCandidates"
                              ItemTemplate="{StaticResource NavigationPathCardTemplate}" />
                <TextBlock x:Name="PathCandidatesPlaceholder"
                           Margin="10"
                           VerticalAlignment="Center"
                           Foreground="#999999"
                           Text="Выберите целевую страницу в графе. Здесь появятся возможные маршруты от текущей страницы."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>
        <local:HorizontalSplitter Grid.Column="1"
                                  ThumbWidth="12"
                                  Background="#333333" />
        <Border Grid.Column="2"
                Padding="0 0">
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="GraphCanvas"
                        MinWidth="480"
                        MinHeight="480"
                        Background="#292929"
                        MouseLeftButtonDown="GraphCanvasMouseLeftButtonDown" />
            </Viewbox>
        </Border>
    </Grid>
</UserControl>