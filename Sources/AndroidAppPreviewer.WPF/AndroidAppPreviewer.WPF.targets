<Project>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../Projects/MsBuild/Library/AndroidAppPreviewerPluginSdk.Managed/AndroidAppPreviewerPluginSdk.Managed.net8.0.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <Resource Include="Resources/Icons/*.svg" />
    <Content Include="Resources/Cursors/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources/Fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>